   "FacilityType [ref]": "https://www.lngindustry.com/liquefaction/31072015/Cheniere-enters-LNG-SPA-with-Central-El-Campesino-1087/, https://www.lngindustry.com/liquid-natural-gas/03092012/Hoegh-LNG-awarded-contract-for-FSRU-in-Chile127/",
