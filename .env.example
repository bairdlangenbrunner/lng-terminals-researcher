# Copy this file to .env and fill in real values. Do NOT commit .env.
#
# Remote entity lookup (entity_lookup.py --remote) against the internal GEM
# project database. The host is deliberately not recorded in this public repo —
# ask GEM staff for it, then extract the session cookies from your browser:
# 1. Log into the internal project-db site and set its URL below
# 2. Open DevTools → Application → Cookies
# 3. Copy sessionid and csrftoken values
# Cookies expire periodically; re-extract when lookups start returning 302s.
GEM_PROJECT_DB_BASE_URL=
GEM_PROJECT_DB_SESSIONID=
GEM_PROJECT_DB_CSRFTOKEN=

# Read-only Postgres for pulls/timelines (usually exported in your shell, not
# .env): GEM_READONLY_DB_URL — used by ../gem-db-ops/gem_query.py,
# fetch_timeline.py, refsweep_missing_year.py, captive_power_colocation.py.

# Optional. Path to the LNG Carrier Tracker project's vessels CSV export.
# Enables fsru_sync_check.py to cross-check FSRU vessel records between trackers.
# If unset, fsru_sync_check.py short-circuits to gem-only mode.
CARRIER_VESSELS_CSV_PATH=
