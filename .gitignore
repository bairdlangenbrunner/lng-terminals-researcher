# Auth and secrets
.env

# Data pulls and derived files
*.colmap.json
*.csv
giignl_extracted/
giignl_pages/

# Reconciliation diff output (regenerable by report_diff.py)
giignl_diff.json
report_diff.json

# FSRU fleet extraction (regenerable by giignl_fsru_fleet.py)
giignl_fsru_fleet.json

# Derived sweep / index outputs (regenerable by dedup_index.py / stale_sweep.py /
# completeness_sweep.py). Scripts default to writing under work/ (ignored except
# its .gitkeep). The bare filenames are also ignored for the case where a script
# is run with an explicit cwd-relative --output (e.g. Triage SOP's stale_sweep).
work/*
!work/.gitkeep
scripts/work/
dedup_index.json
stale_sweep.json
completeness_sweep.json
fsru_sync.json

# Per-batch staged inputs / agent-authored findings. Loose copies in the repo
# root or scripts/ are scratch and stay ignored — the organized home is the
# staging tree (see batches/staging/README.md):
#   batches/staging/recon/<report><year>/   reconciliation batches (e.g. recon/giignl2026/)
#   batches/staging/<scope-slug>/           ad-hoc single-scope update/discovery batches
# Agent-authored inputs there ARE tracked (diffable audit trail — the recon xlsx
# silently drops sheets when they go missing). Derived artifacts (extracted CSV,
# diff, FSRU fleet) stay ignored everywhere via the patterns above; assembled
# sweep outputs (_build/) and parked prior batches (_prior/<batch>/)
# sit one level deeper than the re-includes below, so they stay ignored.
# Cross-batch state (monitor_list/current.json) is committed.
staged_*.json
giignl_narrative_findings.json
giignl_prose_corrections.json
!batches/staging/recon/**/staged_*.json
!batches/staging/recon/**/giignl_narrative_findings.json
!batches/staging/recon/**/giignl_prose_corrections.json
!batches/staging/*/staged_*.json
# Captive-power staging nests one level deeper (captive_power/<area>/), like recon — track it too.
!batches/staging/captive_power/**/staged_*.json

# Derived per-region build scratch (assembled staged_*.json + the _roster_*.json the build
# regenerates each run). Fully reproducible from the tracked per-country JSON; never commit.
batches/staging/*/_build/

# Batch deliverable workbooks are large regenerable binaries — keep them untracked.
# But TRACK the staging tree (batches/staging/**: per-country research JSON, the sweep
# ledger, briefs, README) — it's the diffable audit trail and lives on the batch branch.
# (The derived _build/ and _prior/ staged_*.json stay ignored via the staged_*.json rule above.)
# NB: deliberately TOP-LEVEL-ONLY (no **) so batches/deliverables/*.xlsx stays trackable —
# kept-long-term workbooks are committed there (see batches/deliverables/README.md).
batches/*.xlsx
# Derived staging workbooks are regenerable too (a kept copy goes to batches/deliverables/).
batches/staging/**/*.xlsx
# Superseded workbooks parked for pruning (derived artifacts, never committed).
batches/old/

# Python
.pytest_cache/
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.python-version

# Transient scheduler artifacts (session-local cron lock/state from CronCreate)
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json

# OS
.DS_Store
Thumbs.db

# codegraph local index (derived)
.codegraph/

# transient sweep scratch reports (re-derivable from completeness_sweep.py)
batches/staging/.tmp_*
